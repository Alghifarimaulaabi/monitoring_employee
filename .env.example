# ==============================================================================
# B-Tracker - Environment Variables Template (.env.example)
# Salin file ini menjadi .env atau .env.local dan isi nilai konfigurasinya
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. DATABASE (PostgreSQL / Supabase / Neon / etc.)
# ------------------------------------------------------------------------------
# URL koneksi database PostgreSQL (bisa menggunakan connection pooler seperti Supabase port 6543)
DATABASE_URL="postgresql://postgres:password@localhost:5432/monitoring_employee"

# URL koneksi langsung untuk migrasi Prisma (opsional jika menggunakan pooler)
DIRECT_URL="postgresql://postgres:password@localhost:5432/monitoring_employee"


# ------------------------------------------------------------------------------
# 2. AUTHENTICATION (Better Auth)
# ------------------------------------------------------------------------------
# Secret key untuk enkripsi session token (buat dengan: openssl rand -base64 32)
BETTER_AUTH_SECRET="your-super-secret-better-auth-key-at-least-32-chars-long"

# Base URL aplikasi untuk validasi session dan redirect auth
BETTER_AUTH_URL="http://localhost:3000"

# URL publik aplikasi yang dapat diakses di browser client
NEXT_PUBLIC_APP_URL="http://localhost:3000"


# ------------------------------------------------------------------------------
# 3. SUPABASE STORAGE (Penyimpanan Foto Buket)
# ------------------------------------------------------------------------------
# URL project Supabase Anda
NEXT_PUBLIC_SUPABASE_URL="https://your-project-id.supabase.co"

# Supabase Public Anon Key
NEXT_PUBLIC_SUPABASE_ANON_KEY="your-supabase-anon-key"

# Supabase Service Role Key (untuk upload & manajemen file dari server)
SUPABASE_SERVICE_ROLE_KEY="your-supabase-service-role-key"

# Nama bucket penyimpanan foto buket
SUPABASE_STORAGE_BUCKET="bouquet-photos"


# ------------------------------------------------------------------------------
# 4. INITIAL SEED OWNER (Opsional: untuk menjalankan 'pnpm run seed')
# ------------------------------------------------------------------------------
INITIAL_OWNER_NAME="Owner Florist"
INITIAL_OWNER_EMAIL="owner@btracker.com"
INITIAL_OWNER_PASSWORD="password123"
